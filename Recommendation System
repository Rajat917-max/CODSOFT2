# Bollywood movie dataset
movies = {
    "3 Idiots": "Drama",
    "Dangal": "Sports",
    "PK": "Comedy",
    "Bajrangi Bhaijaan": "Drama",
    "Kabir Singh": "Romance",
    "Dilwale Dulhania Le Jayenge": "Romance",
    "Sholay": "Action",
    "War": "Action",
    "Taare Zameen Par": "Drama",
    "Andhadhun": "Thriller",
    "Drishyam": "Thriller",
    "Munna Bhai MBBS": "Comedy",
    "Chennai Express": "Comedy",
    "Lagaan": "Sports",
    "Queen": "Drama"
}

print("Welcome to the Bollywood Movie Recommendation System")
print("\nAvailable Movies:")

for movie in movies:
    print("-", movie)

# User input
user_movie = input("\nEnter a Bollywood movie you like: ")

# Check if movie exists
if user_movie in movies:
    genre = movies[user_movie]
    print(f"\nSince you like '{user_movie}' ({genre}), you may also like:")

    # Recommend movies of the same genre
    for movie, g in movies.items():
        if g == genre and movie != user_movie:
            print("-", movie)
else:
    print("Movie not found in our Bollywood database. Please try another one.")
